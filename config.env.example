# 钓鱼游戏 - Go 服务启动配置（复制本文件为 config.env 后填写）
# 每行一个 KEY=VALUE，可用 # 开头的注释行。run.bat / Start-Game-HTTPS.bat / migrate.exe 都会读取。

# 必填：PostgreSQL 应用连接串（应用账号，非超级用户）
FISHING_GO_DATABASE_URL=postgres://fishing_app:CHANGE_ME@127.0.0.1:5432/fishing?sslmode=disable

# 可选：业务时区，与原服保持一致
FISHING_GO_TIMEZONE=Asia/Shanghai

# 可选：监听地址，默认 127.0.0.1:9000（HTTPS 启动器固定使用 127.0.0.1:9001）
# FISHING_GO_LISTEN=127.0.0.1:9000

# 可选：连接池上限，默认 16
# FISHING_GO_DB_MAX_CONNS=16

# 可选：管理员 MFA 加密密钥（base64 的 32 字节），首次配置管理员前必须设置并妥善保存
# FISHING_GO_MFA_KEY=