# ---- 账号数据：含密码哈希与盐，绝不入库 ----
# 运行时数据默认写到用户「文档」目录（Documents/web-fishing-game），
# 下面两条同时排除旧的仓库内数据目录与任何残留。
data/
backend/data/

# ---- 本地 agent 工作区记忆（工具数据，非项目源码） ----
.workbuddy/

# ---- 测试临时产物 ----
tests/_*.log
tests/*-report.txt
tests/last-run.txt
# 截图产物：由 tests/shots*.js 重新生成，不入库
tests/shots/

# ---- 依赖与日志 ----
node_modules/
*.log
npm-debug.log*

# ---- Python 缓存 ----
__pycache__/
*.pyc

# ---- 打包产物 ----
dist/

# ---- 本地部署配置（含数据库连接串，绝不入库） ----
config.env

# GitHub 发布凭据，仅本地使用，禁止入库
tools/.github-token
# 测试生成的预览截图
output/

# Go build/test output and private offline migration snapshots/reports.
server-go/bin/
server-go/coverage.out
migration-private/
